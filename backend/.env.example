# .env.example
# Backend environment variables (copy to .env and fill values)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/3dunity?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
WHATSAPP_NUMBER=your_whatsapp_number_without_plus
PORT=5000

